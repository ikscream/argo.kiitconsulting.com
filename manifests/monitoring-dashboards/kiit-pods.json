  {
   "id": 16,
   "type": "timeseries",
   "title": "Container restarts by pod (1h)",
   "description": "Only pods that restarted appear - an empty panel means nothing crashed. A rising line is a crash loop.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 35,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
