  {
   "id": 13,
   "type": "table",
   "title": "Resources by container",
   "description": "Live usage beside what each container reserved. CPU limits are omitted on purpose - almost nothing here sets one.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum by(namespace,pod,container)(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\"}[$__rate_interval]))",
     "refId": "A",
