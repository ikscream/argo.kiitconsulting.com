{
 "uid": "kiit-pods",
 "title": "Kiit / Pods",
 "description": "Pods and their containers on either cluster: what is running, what it is using, and how that compares with what it reserved. Pick the datasource (Stockholm is bayes), then a namespace and pod. Written for this estate to replace the vendored 'Kubernetes / Views / Pods', whose gauges read past 100% and whose CPU-limit panels are empty because almost nothing here caps CPU.",
 "tags": [
  "kiit",
  "kubernetes",
  "pods"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "label": "Datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus (Stockholm)",
     "value": "afxk8mv40v2tcd",
     "selected": true
    },
    "hide": 0,
    "refresh": 1,
    "regex": "",
    "includeAll": false,
    "multi": false,
    "options": []
   },
   {
    "name": "namespace",
    "type": "query",
    "label": "Namespace",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "definition": "label_values(kube_pod_info, namespace)",
    "query": {
     "qryType": 1,
     "query": "label_values(kube_pod_info, namespace)",
     "refId": "PrometheusVariableQueryEditor-VariableQuery"
    },
    "current": {
     "text": "bayes",
     "value": "bayes",
     "selected": true
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "regex": "",
    "hide": 0,
    "options": []
   },
   {
    "name": "pod",
    "type": "query",
    "label": "Pod",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "definition": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
    "query": {
     "qryType": 1,
     "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
     "refId": "PrometheusVariableQueryEditor-VariableQuery"
    },
    "current": {
     "text": "All",
     "value": "$__all",
     "selected": true
    },
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "refresh": 2,
    "sort": 1,
    "regex": "",
    "hide": 0,
    "options": []
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Pods running",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"}==1) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds",
      "fixedColor": "text"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Pods not running",
   "description": "Pending, Failed or Unknown. Succeeded (finished jobs) is not counted.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=~\"Pending|Failed|Unknown\"}==1) or vector(0)",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "center"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "thresholds",
      "fixedColor": "text"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Containers",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(kube_pod_container_status_running{namespace=~\"$namespace\"}) or vector(0)",
     "refId": "A",
     "instant": true
